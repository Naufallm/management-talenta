# npm run setup generates a random encryption key in .env for local development.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Empty = persistent embedded PostgreSQL (PGlite), development only.
# Production requires an external PostgreSQL connection and HTTPS.
DATABASE_URL=
PGLITE_DIR=./data/postgres
# Exactly 64 hexadecimal characters; preserve securely across restarts/backups.
DATA_ENCRYPTION_KEY=
# Temporary work-branch testing: shared password 123456 and no first-login password change.
# Ignored in production. Set false to restore the normal account/password policy.
TEST_LOGIN_ENABLED=true
SEED_PASSWORD=123456
# Set true only behind one trusted reverse proxy terminating HTTPS.
TRUST_PROXY=false
# Production bootstrap only: set as temporary environment variables for admin:create.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_PASSWORD=
